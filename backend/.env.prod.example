# Copy to backend/.env.prod (gitignored) and fill real values.
# Never commit secrets.

# --- Core ---
DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com,localhost
# True only with the provided Caddy proxy or an equivalent trusted proxy.
DJANGO_TRUST_PROXY=True
APP_HOST=app.example.com
API_HOST=api.example.com
JWT_SECRET_KEY=replace-with-long-random-jwt-key

# Fernet key (required when DEBUG=False):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Compose / managed DB (docker-compose.prod.yml also sets DATABASE_URL from these)
POSTGRES_USER=swm_user
POSTGRES_PASSWORD=replace-strong-password
POSTGRES_DB=swm_db
DATABASE_URL=postgres://swm_user:replace-strong-password@db:5432/swm_db

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Public URLs (must match TLS hostnames)
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com

# Frontend build args (compose)
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.example.com/ws
NEXT_PUBLIC_APP_URL=https://app.example.com
# Keep false on staging; set true and rebuild for public production.
NEXT_PUBLIC_INDEXABLE=false

# --- Email (pick one path) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
# Or: ANYMAIL_ESP=sendgrid + SENDGRID_API_KEY=

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Billing (test keys on staging, live on production) ---
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_ENTERPRISE=

# --- Launch connectors (optional until smoke-tested) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# aliases also accepted: GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
OPENAI_API_KEY=

# Bump a version only when the matching policy text is published; existing users must review it.
TERMS_VERSION=2026-11-04
PRIVACY_VERSION=2026-11-04
