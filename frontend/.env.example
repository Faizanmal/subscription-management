# Must include the /api/v1 prefix — the client calls paths like /auth/token/
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=false

# Optional public identity; leave blank until the business details are decided.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_COUNTRY=
NEXT_PUBLIC_SUPPORT_EMAIL=support@subscriptionwastemanager.com
